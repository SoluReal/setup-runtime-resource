# Per-test knobs for ci/tasks/run-tests.sh. Sourced, so plain assignments only.

# pip caches under $HOME/.cache/pip, which is in the rootfs and not the cache
# volume, so `pip install -r requirements.txt` downloads its wheels on every run.
SKIP_CACHE_CHECK="true"

# What this test can still prove: the interpreter pyenv built on the first run
# came back from the cache instead of being compiled again. Without it the run
# asserts nothing at all about caching.
EXPECT_IN_OUTPUT="\[cache\] restore pyenv from=local versions=[1-9]"
