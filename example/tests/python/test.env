# Per-test knobs for ci/tasks/run-tests.sh. Sourced, so plain assignments only.

# pip caches under $HOME/.cache/pip, which is in the rootfs and not the cache
# volume, so `pip install -r requirements.txt` downloads its wheels on every run.
# The interpreter is not cached either: pyenv keeps its versions inside the
# rootfs, which a task cannot write back to, so `pyenv install` recompiles
# whatever the image did not already ship.
SKIP_CACHE_CHECK="true"
