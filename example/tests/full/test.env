# Per-test knobs for ci/tasks/run-tests.sh and build-and-test.sh. Sourced, so
# plain assignments only.

# source.yml asks for rootless podman, which is what CI runs. The local worker has
# no unprivileged user namespaces, so run this one against dockerd here instead;
# the dedicated testcontainers-rootless test is the one that needs real podman.
FORCE_ROOTLESS="false"

# This one deliberately does the lot: it pulls nginx twice, builds an image, runs
# `nvm install` and fetches a project from start.spring.io, all on every run. The
# focused tests below it are where a missed cache has to show up.
SKIP_CACHE_CHECK="true"
