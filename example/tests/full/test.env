# source.yml asks for rootless podman (CI); the local worker has no unprivileged user namespaces,
# so run dockerd here. testcontainers-rootless is the test that needs real podman.
FORCE_ROOTLESS="false"

# Deliberately does everything on every run (nginx pulls, image build, nvm install, spring
# download); the focused tests are where a missed cache has to show up.
SKIP_CACHE_CHECK="true"

# The nginx images the first run saved must be loaded back from the task cache.
EXPECT_IN_OUTPUT="\[cache\] restore docker-images from=local images=[1-9]"
