# Per-test knobs for ci/tasks/run-tests.sh. Sourced, so plain assignments only.
# EXPECT_IN_OUTPUT holds one extended regex per line, all matched against the
# second run's build log.

# npm and pnpm keep their stores in $CACHE_DIRECTORY, and nvm's versions
# directory is symlinked into it, so the first run's node install is still there
# on the second. Yarn is deliberately absent: yarn 4 ignores YARN_CACHE_FOLDER,
# so its cache location is not this repo's to assert.
EXPECT_IN_OUTPUT="\[cache\] restore node/npm from=local files=[1-9]
\[cache\] restore node/pnpm from=local files=[1-9]
\[cache\] restore nvm from=local versions=[1-9]"
