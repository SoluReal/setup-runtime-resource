# Per-test knobs for ci/tasks/run-tests.sh. Sourced, so plain assignments only.
# EXPECT_IN_OUTPUT holds one extended regex per line, all matched against the
# second run's build log.

# This test installs a node, a java and a python through the version managers,
# so the second run has to find all three already unpacked in the task cache.
EXPECT_IN_OUTPUT="\[cache\] restore nvm from=local versions=[1-9]
\[cache\] restore pyenv from=local versions=[1-9]
\[cache\] restore sdkman from=local"
