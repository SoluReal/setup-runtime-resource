# Per-test knobs for ci/tasks/run-tests.sh. Sourced, so plain assignments only.
# EXPECT_IN_OUTPUT holds one extended regex per line, all matched against the
# second run's build log.

# The download check is a negative: it also passes for a run that did nothing.
# These say what the second run must have done - every cache the build needs was
# already on the worker, restored from the Concourse task cache.
EXPECT_IN_OUTPUT="\[cache\] restore maven/repository from=local files=[1-9]
\[cache\] restore maven/wrapper-dists from=local files=[1-9]
\[cache\] restore sdkman from=local"
