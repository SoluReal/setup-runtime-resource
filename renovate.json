{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "ignorePaths": ["**/example/**", "test/resources/projects/**"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^assets/.+\\.sh$/", "/^Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n(?:ARG )?[A-Z_]+_VERSION=(?<currentValue>\\S+)(?: [A-Z_]+_COMMIT=(?<currentDigest>[0-9a-f]{40}))?"
      ]
    }
  ]
}
