#!/bin/bash

set -eo pipefail

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

export ROOT_DIR=$(dirname $0)
source $ROOT_DIR/common.sh
source $ROOT_DIR/installers/testcontainers.sh
source $ROOT_DIR/installers/sdkman.sh
source $ROOT_DIR/installers/node.sh
source $ROOT_DIR/installers/pyenv.sh
source $ROOT_DIR/installers/golang.sh
source $ROOT_DIR/installers/rootfs.sh

dest=$1

payload="$(cat <&0)"

hash=$(hash_source "$payload")

extra_dependencies=$(jq -r '(.source.dependencies // [] | join(" "))' <<< "$payload")
hook=$(jq -r '(.source.hook // "")' <<< "$payload")
verbose=$(jq -r '(.source.verbose // "")' <<< "$payload")
telemetry=$(jq -r '(.source.telemetry.disable // "")' <<< "$payload")

export testcontainers_enabled=$(jq -r '(.source.testcontainers.enabled // "false")' <<< "$payload")
export testcontainers_rootless=$(jq -r '(.source.testcontainers.rootless // "false")' <<< "$payload")
export java_version=$(jq -r '(.source.java.version // "")' <<< "$payload")
export sdkman_enabled=$(jq -r '(.source.sdkman.enabled // "false")' <<< "$payload")
export extra_java_versions=$(jq -r '(.source.java.extra_versions // [])' <<< "$payload")
export nvm_enabled=$(jq -r '(.source.nvm.enabled // "false")' <<< "$payload")
export nodejs_version=$(jq -r '(.source.nodejs.version // "")' <<< "$payload")
export yarn_version=$(jq -r '(.source.nodejs.yarn.version // "")' <<< "$payload")
export pnpm_version=$(jq -r '(.source.nodejs.pnpm.version // "")' <<< "$payload")
export bun_version=$(jq -r '(.source.nodejs.bun.version // "")' <<< "$payload")

export maven_version=$(jq -r '(.source.maven.version // "")' <<< "$payload")
export maven_wrapper=$(jq -r '(.source.maven.wrapper // "false")' <<< "$payload")
export gradle_version=$(jq -r '(.source.gradle.version // "")' <<< "$payload")
export gradle_wrapper=$(jq -r '(.source.gradle.wrapper // "false")' <<< "$payload")

export pyenv_enabled=$(jq -r '(.source.pyenv.enabled // "false")' <<< "$payload")
export golang_version=$(jq -r '(.source.golang.version // "")' <<< "$payload")
export debian_proxy=$(jq -r '(.source.debian_proxy // "")' <<< "$payload")
export minimal_image=$(jq -r '(.source.minimal_image // "false")' <<< "$payload")

export dependency_download_retries=$(jq -r '(.source.dependency_download_retries // "0")' <<< "$payload")

export VERBOSE=$verbose
export DISABLE_TELEMETRY=$telemetry
export DEBUG=$(jq -r '(.source.debug // "false")' <<< "$payload")

# Hooks and dependencies like curl or git need the CA bundle even when no runtime pulls it in.
dependencies="
  ca-certificates
  $extra_dependencies
  $(sdkman_get_dependencies)
  $(node_get_dependencies)
  $(pyenv_get_dependencies)
  $(golang_get_dependencies)
  $(testcontainers_get_dependencies)
"
dependencies=$(echo "$dependencies" | tr -s ' ' '\n' | sort -u | tr '\n' ' ' | xargs)

DEBIAN_VERSION=trixie
rootfs="$dest/rootfs"

export OUTPUT_FILE=/tmp/info_log
touch $OUTPUT_FILE
tail -f "$OUTPUT_FILE" &
INFO_LOGGER_PID=$!
# A surviving tail holds the task's stderr open, so Concourse would wait on a failed build forever.
trap 'kill $INFO_LOGGER_PID 2>/dev/null || true' EXIT

if [[ -n "${debian_proxy:-}" ]]; then
  info "Using debian proxy: $debian_proxy"
fi

info "Extracting the base rootfs and installing dependencies (this can take some time)..."
rootfs_extract_base
rootfs_configure_apt
log_on_error rootfs_install_dependencies "$dependencies"
log_on_error rootfs_remove_installer

mkdir -p "$rootfs$RUNTIME_DIR/plugins"

# Run after the installer is gone: the cleanup hook deletes the dpkg database the removal needs.
for customize_hook in "$ROOT_DIR"/hooks/customize-*.sh; do
  log_on_error bash "$customize_hook" "$rootfs"
done

kill $INFO_LOGGER_PID
trap - EXIT

if [[ -n "$hook" ]]; then
  info "Running custom hook..."
  log_on_error chroot_exec "$dest/rootfs/" "set -e;$hook"
  info "Custom hook finished"
fi

if [[ "$minimal_image" = "true" ]]; then
  add_metadata "minimal-image" "true"
  # The cleanup hook deleted the dpkg database, so a listed apt and dpkg's helpers can't work any more.
  rm -rf "$dest/rootfs"/usr/bin/apt* "$dest/rootfs"/usr/lib/apt "$dest/rootfs"/usr/lib/*-linux-gnu/libapt-* \
    "$dest/rootfs"/var/lib/apt "$dest/rootfs"/var/cache/apt "$dest/rootfs"/var/log/apt "$dest/rootfs"/etc/apt
  find "$dest/rootfs/usr/bin" -maxdepth 1 -name 'dpkg-*' -delete
fi

rootfs_fix_symlinks

add_task_env_var "BASH_ENV=$RUNTIME_HOME/.bashrc"
add_task_env_var "HOME=$RUNTIME_HOME"

# Tasks run as the runtime user, except non-rootless testcontainers: dockerd
# needs real root and the runtime user has no way to escalate.
task_user="$RUNTIME_USER"
if [[ "$testcontainers_enabled" = "true" && "$testcontainers_rootless" != "true" ]]; then
  task_user=""
fi

add_metadata "user" "$task_user"

# BASH_ENV makes non-interactive shells load the bash profile.
jq -n "{
  env: [$(sed 's/.*/\"&\"/' /tmp/env_vars | tr '\n' ',' | sed 's/,$//')],
  user: \"$task_user\"}
" > "$dest/metadata.json"

log_on_error cat "$dest/metadata.json"

add_trap teardown_setup_runtime EXIT

# bash allows one trap directive, so all traps run from one function, and only in the main
# process (its pid is saved at startup) since sub-bashes would otherwise re-run them.
for f in /tmp/traps_*; do
  if [[ -e "$f" ]]; then
    sig="${f#/tmp/traps_}"
    cmds=$(paste -sd ";" "$f")
    echo "function trap_$sig() {
    current_pid=\$\$
    main_pid=\$(cat /tmp/main_pid)
  if [[ \"\$current_pid\" = \"\$main_pid\" ]]; then
    $cmds
  fi
}" >> "$dest/rootfs$RUNTIME_HOME/.bashrc"
    echo "trap \"trap_$sig\" $sig" >> "$dest/rootfs$RUNTIME_HOME/.bashrc"
  fi
done

cat "$ROOT_DIR/includes/bashrc.sh" >> "$dest/rootfs$RUNTIME_HOME/.bashrc"

# The build ran as root. The task user needs to write to both: sdk/nvm/pyenv
# install into $RUNTIME_DIR at task time, gradle/maven write under $HOME.
chown -R "$RUNTIME_UID:$RUNTIME_UID" "$dest/rootfs$RUNTIME_HOME" "$dest/rootfs$RUNTIME_DIR"

info "Total size of setup-runtime rootfs: $(du -sh "$dest/rootfs" | awk '{print $1}')"

touch /tmp/metadata || true

METADATA=$(cat /tmp/metadata 2>/dev/null | tr -s '\n' ',' | sed 's/,$//')

rm -rf /tmp/node-compile-cache

jq -n \
  --arg hash "$hash" \
  "{ version: { hash: \$hash }, metadata: [$METADATA] }" >&3
