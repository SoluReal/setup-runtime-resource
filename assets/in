#!/bin/bash

set -eo pipefail

exec 3>&1 # make stdout available as fd 3 for the result
exec 1>&2 # redirect all output to stderr for logging

export ROOT_DIR=$(dirname $0)
source $ROOT_DIR/common.sh
source $ROOT_DIR/installers/testcontainers.sh
source $ROOT_DIR/installers/rootfs.sh

dest=$1

payload="$(cat <&0)"

hash=$(hash_source "$payload")

# One jq call reads every option into a shell variable; a missing option gets its default.
eval "$(jq -r '.source as $s | {
  dependencies: ($s.dependencies // [] | join(" ")),
  hook: ($s.hook // ""),
  VERBOSE: ($s.verbose // ""),
  DEBUG: ($s.debug // false),
  telemetry_enabled: ($s.telemetry.enabled | if . == null then true else . end),
  testcontainers_enabled: ($s.testcontainers.enabled // false),
  testcontainers_rootless: ($s.testcontainers.rootless // false),
  java_version: ($s.java.version // ""),
  extra_java_versions: ($s.java.extra_versions // [] | tojson),
  sdkman_enabled: ($s.sdkman.enabled // false),
  nvm_enabled: ($s.nvm.enabled // false),
  nodejs_version: ($s.nodejs.version // ""),
  yarn_version: ($s.nodejs.yarn.version // ""),
  pnpm_version: ($s.nodejs.pnpm.version // ""),
  bun_version: ($s.nodejs.bun.version // ""),
  maven_version: ($s.maven.version // ""),
  maven_wrapper: ($s.maven.wrapper // false),
  gradle_version: ($s.gradle.version // ""),
  gradle_wrapper: ($s.gradle.wrapper // false),
  python_version: ($s.python.version // ""),
  uv_enabled: ($s.uv.enabled // false),
  golang_version: ($s.golang.version // ""),
  debian_proxy: ($s.debian_proxy // ""),
  minimal_image: ($s.minimal_image // false),
  dependency_download_retries: ($s.dependency_download_retries // 0)
} | to_entries[] | "export \(.key)=\(.value | tostring | @sh)"' <<< "$payload")"

export DISABLE_TELEMETRY=false
[[ "$telemetry_enabled" = "false" ]] && DISABLE_TELEMETRY=true

dependencies="
  $dependencies
  $(runtime_dependencies sdkman)
  $(runtime_dependencies nvm)
  $(runtime_dependencies golang)
  $(testcontainers_get_dependencies)
"
dependencies=$(echo "$dependencies" | tr -s ' ' '\n' | sort -u | tr '\n' ' ' | xargs)

rootfs="$dest/rootfs"

export STATE_DIR
STATE_DIR=$(mktemp -d)
touch "$STATE_DIR/env_vars" "$STATE_DIR/metadata"
export OUTPUT_FILE="$STATE_DIR/info_log"
touch "$OUTPUT_FILE"
# --pid makes tail drain the file and exit once this script ends; killing it early drops the last
# lines whenever the large verbose group blocks leave it behind.
tail -f -s 0.2 --pid=$$ "$OUTPUT_FILE" 3>&- &
INFO_LOGGER_PID=$!
# A surviving tail or runtime installer holds the task's stderr open, so Concourse would wait on a failed build forever.
RUNTIMES_PID=""
trap 'kill $INFO_LOGGER_PID 2>/dev/null || true; [[ -z "$RUNTIMES_PID" ]] || kill -- -$RUNTIMES_PID 2>/dev/null || true' EXIT

# apt closes every possible descriptor before running a method, which with a worker's 2^31 limit takes hours.
[[ "$(ulimit -n)" != unlimited ]] && (( $(ulimit -n) <= 65536 )) || ulimit -Sn 65536

info "Extracting the base rootfs and installing dependencies (this can take some time)..."
rootfs_extract_base
rootfs_configure_apt
testcontainers_configure_apt

mkdir -p "$rootfs$RUNTIME_DIR/plugins"

# The runtime installers run on the host and don't need the dependencies, so they overlap with the apt install
# (their own process group, so the trap can stop them).
set -m
log_on_error bash "$ROOT_DIR/hooks/runtimes.sh" "$rootfs" &
RUNTIMES_PID=$!
set +m

log_on_error rootfs_install_dependencies "$dependencies"

log_on_error bash "$ROOT_DIR/hooks/runtime-user.sh" "$rootfs"
log_on_error bash "$ROOT_DIR/hooks/testcontainers.sh" "$rootfs"
wait "$RUNTIMES_PID" || exit $?
RUNTIMES_PID=""
log_on_error bash "$ROOT_DIR/hooks/cleanup.sh" "$rootfs"

log_on_error rootfs_remove_installer

trap - EXIT

if [[ -n "$hook" ]]; then
  info "Running custom hook..."
  # The runtimes' .bashrc lines (PATH, sdkman, nvm) are live in the hook; bashrc.sh's plugins are not yet.
  log_on_error rootfs_exec /bin/bash -lc "[[ ! -f $RUNTIME_HOME/.bashrc ]] || source $RUNTIME_HOME/.bashrc; set -e; $hook"
  info "Custom hook finished"
fi

if [[ "$minimal_image" = "true" ]]; then
  add_metadata "minimal-image" "true"
  # rootfs_remove_installer deleted the dpkg database, so dpkg's helpers can't work any more.
  find "$dest/rootfs/usr/bin" -maxdepth 1 -name 'dpkg-*' -delete
fi

rootfs_remove_dev
rootfs_fix_symlinks

add_task_env_var "BASH_ENV=$RUNTIME_HOME/.bashrc"
add_task_env_var "HOME=$RUNTIME_HOME"

# Tasks run as the runtime user, except non-rootless testcontainers: dockerd
# needs real root and the runtime user has no way to escalate.
task_user="$RUNTIME_USER"
if testcontainers_uses_docker; then
  task_user=""
fi

add_metadata "user" "$task_user"

jq -n --arg user "$task_user" --rawfile env "$STATE_DIR/env_vars" \
  '{env: ($env | split("\n") | map(select(length > 0))), user: $user}' > "$dest/metadata.json"

log_on_error cat "$dest/metadata.json"

cat "$ROOT_DIR/includes/bashrc.sh" >> "$dest/rootfs$RUNTIME_HOME/.bashrc"

# The build ran as root. The task user needs to write to both: sdk/nvm/uv
# install into $RUNTIME_DIR at task time, gradle/maven write under $HOME.
chown -R "$RUNTIME_UID:$RUNTIME_UID" "$dest/rootfs$RUNTIME_HOME" "$dest/rootfs$RUNTIME_DIR"

info "Total size of setup-runtime rootfs: $(du -sh "$dest/rootfs" | awk '{print $1}')"

jq -n --arg hash "$hash" --slurpfile metadata "$STATE_DIR/metadata" '{version: {hash: $hash}, metadata: $metadata}' >&3
